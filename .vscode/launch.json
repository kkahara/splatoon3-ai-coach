{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "videoName",
            "type": "promptString",
            "description": "Video / analysis folder name (no .mov), e.g. 2026-09-05 09-34-24",
            "default": "2026-09-05 23-15-32"
        }
    ],
    "configurations": [
        {
            "name": "s3-coach: vision-view",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/s3-coach",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-v",
                "vision-view",
                "${workspaceFolder}/analysis/${input:videoName}/vision_manifest.json",
                "--config",
                "${workspaceFolder}/configs/default.yaml",
                "--video",
                "/Users/kenjikahara/Movies/${input:videoName}.mov"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "s3-coach: analyze w debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/s3-coach",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-v",
                "analyze",
                "/Users/kenjikahara/Movies/${input:videoName}.mov",
                "--out",
                "${workspaceFolder}/analysis/${input:videoName}",
                "--config",
                "${workspaceFolder}/configs/default.yaml",
                "--debug-persist-cadence-frames"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "s3-coach: analyze w debug mp4",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/s3-coach",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-v",
                "analyze",
                "/Users/kenjikahara/Movies/${input:videoName}.mp4",
                "--out",
                "${workspaceFolder}/analysis/${input:videoName}",
                "--config",
                "${workspaceFolder}/configs/default.yaml",
                "--debug-persist-cadence-frames"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "s3-coach: inspect",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/s3-coach",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-v",
                "inspect",
                "/Users/kenjikahara/Movies/${input:videoName}.mov"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "s3-coach: calibrate-timer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/s3-coach",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-v",
                "calibrate-timer",
                "/Users/kenjikahara/Movies/${input:videoName}.mov",
                "--out",
                "${workspaceFolder}/calibration/${input:videoName}",
                "--config",
                "${workspaceFolder}/configs/default.yaml",
                "--sample-fps",
                "0.08"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
