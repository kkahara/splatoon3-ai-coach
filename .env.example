# Copy to `.env` (gitignored) and fill in. Never commit real keys.
# S3_COACH_NVIDIA_API_KEY=nvapi-...

# Public site notices via Brevo SMTP. Use the SMTP key (SMTP & API → SMTP),
# not the REST API key. From must be a verified Brevo sender.
# Leave PUBLIC_SMTP_HOST unset to write notices to the outbox instead of sending.
# Port 587 is required; the sender uses STARTTLS.
# PUBLIC_SMTP_HOST=smtp-relay.brevo.com
# PUBLIC_SMTP_PORT=587
# PUBLIC_SMTP_USER=your-brevo-login@email.com
# PUBLIC_SMTP_PASSWORD=your-smtp-key
# PUBLIC_SMTP_FROM=verified-sender@yourdomain.com
# PUBLIC_BASE_URL=https://s3-coaching.1000texts.com

# Contact form recipient. Used only when PUBLIC_SMTP_HOST is set.
# When SMTP is unset, the full message is written to the local outbox instead.
# PUBLIC_CONTACT_TO=you@yourdomain.com
# PUBLIC_CONTACT_PER_HOUR=5

# Accounts and coaching history. Inside Docker Compose the app uses hostname db.
# PUBLIC_DB_PASSWORD=coach
# PUBLIC_DATABASE_URL=postgresql://coach:coach@127.0.0.1:5432/coach
# PUBLIC_ACCOUNT_RETENTION_DAYS=365

# Analysis worker capacity: how many videos THIS worker analyzes at once (not a
# site-wide limit). The admin console value for PUBLIC_WORKER_KEY overrides it
# when the database is configured. PUBLIC_MAX_CONCURRENT is a deprecated alias.
# PUBLIC_WORKER_KEY=default
# PUBLIC_WORKER_CAPACITY=1
